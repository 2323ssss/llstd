PORT=3000

# Discord OAuth2 for the auction page
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:3000/auctions/auth/discord/callback
DISCORD_GUILD_ID=your_discord_guild_id

# Bot token: revoke the exposed token and put the replacement here only.
DISCORD_BOT_TOKEN=your_discord_bot_token

# Discord role IDs, comma-separated (not role names)
ADMIN_ROLE_IDS=your_admin_role_id
COMMAND_ROLE_IDS=your_command_role_id
BLOCKED_ROLE_IDS=your_blocked_role_id

# Generate a unique long value locally before signing in
SESSION_SECRET=replace_with_a_long_random_value

# IP logging is off unless both this and the admin setting are enabled
LOG_CLIENT_IPS=false
APP_BASE_URL=http://localhost:3000
COOKIE_SECURE=false